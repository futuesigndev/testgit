# ============================================
# .gitignore - Python 3.12 Data Analysis Project
# ============================================

# --- Virtual environments ---
.venv/
venv/
env/
ENV/
.python-version

# --- Secrets / Environment variables (สำคัญมาก) ---
.env
.env.*
!.env.example

# --- Python bytecode / cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Packaging / build ---
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# --- Test / coverage ---
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/

# --- Type checkers / linters / formatters ---
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# --- Jupyter Notebook ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# --- Data & output (ไฟล์ข้อมูล/output ไม่ควร commit) ---
data/
output/
outputs/
*.csv
*.tsv
*.xlsx
*.xls
*.parquet
*.feather
*.sqlite
*.db
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.npy
*.npz

# --- Logs ---
*.log
logs/

# --- Editors / IDE ---
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
