# ============================================
# .env.example - เทมเพลตไฟล์ environment variables
# ============================================
# วิธีใช้:
#   1. คัดลอกไฟล์นี้เป็น .env
#      Windows PowerShell:  Copy-Item .env.example .env
#      macOS / Linux:       cp .env.example .env
#   2. แก้ค่าด้านล่างให้เป็นค่าจริงของคุณ
#
# หมายเหตุ: ไฟล์ .env จริงจะไม่ถูก commit ขึ้น git (ดู .gitignore)
#           ไฟล์เทมเพลตนี้ (.env.example) commit ได้ เพื่อให้คนอื่นรู้ว่าต้องตั้งค่าอะไร
# ============================================

# ชื่อผู้ใช้ ใช้แสดงผลใน test.py
# อ่านด้วย os.getenv("USER_NAME")
USER_NAME=your_name_here

# ============================================
# LLM / Chatbot (ใช้โดย chatbot.py)
# ============================================
# chatbot.py อ่านค่าตั้งทั้งหมดจากไฟล์นี้ — ไม่มีค่าตั้งต้นฝังอยู่ในโค้ด
# ถ้าคีย์ใดหายไป chatbot.py จะแจ้งว่าขาดอะไรและหยุดทำงานทันที

# --- การเชื่อมต่อ ---

# ที่อยู่ API ของ SGLang (OpenAI-compatible) ต้องมี /v1 ต่อท้าย
# เข้าถึงผ่าน Tailscale จึงต้องเปิด Tailscale ไว้ด้วย
LLM_BASE_URL=http://100.66.214.124:8888/v1

# ชื่อ model ต้องตรงกับ --served-model-name ที่รัน SGLang ไว้
LLM_MODEL=qwen3.8-27b-sglang

# SGLang ปกติไม่ต้องใช้ API key แต่ openai SDK บังคับให้มีค่า จึงใส่ค่าอะไรก็ได้
# ถ้า server รันด้วย --api-key ให้เปลี่ยนเป็นค่านั้น
LLM_API_KEY=dummy

# --- พฤติกรรมของ chatbot ---

# persona ของผู้ช่วย (system prompt)
LLM_SYSTEM_PROMPT=คุณเป็นผู้ช่วย AI ที่ตอบคำถามเป็นภาษาไทย ตอบให้กระชับ ตรงประเด็น และเข้าใจง่าย ถ้าไม่แน่ใจในคำตอบ ให้บอกว่าไม่แน่ใจแทนการเดา

# จำนวนข้อความสูงสุดที่ส่งให้โมเดลต่อครั้ง (system message ไม่นับ) เกินแล้วตัดคู่เก่าสุดออก
LLM_MAX_HISTORY_MESSAGES=20

# ความสร้างสรรค์ของคำตอบ (0 = นิ่งและซ้ำเดิม, 2 = สร้างสรรค์มาก)
# หมายเหตุ: ค่าสูงทำให้ภาษาไทยเพี้ยนได้ (สระ/วรรณยุกต์หาย) จึงแนะนำไม่เกิน 0.3
LLM_TEMPERATURE=0.3

# ปิดโหมดคิดก่อนตอบของ reasoning model
# true = ตอบเร็วและประหยัด token | false = ให้โมเดลคิดก่อนตอบ (คุณภาพดีขึ้นแต่ช้าและกิน token)
LLM_DISABLE_THINKING=true

# แสดงกระบวนการคิดของโมเดลออกมาด้วย (ใช้เมื่อตั้ง LLM_DISABLE_THINKING=false)
LLM_SHOW_REASONING=false

# จำนวน token สูงสุดของคำตอบ — เว้นว่างเพื่อใช้ค่า default ของ server
# ภาษาไทยกิน token มากกว่าอังกฤษ จึงควรเผื่อไว้พอสมควร
LLM_MAX_COMPLETION_TOKENS=4096

# timeout ต่อคำขอ หน่วยวินาที (โมเดล local อาจใช้เวลาคิดนาน)
LLM_REQUEST_TIMEOUT=180

# จำนวนครั้งที่ retry อัตโนมัติเมื่อ connection error / 429 / 5xx
LLM_MAX_RETRIES=2

# ขอ token usage ตอน stream — SGLang ไม่ส่งมาให้ถ้าไม่ขอ (true / false)
LLM_INCLUDE_USAGE=true

# แสดงข้อความ "กำลังคิด..." ถ้าโมเดลเงียบนานเกินกี่วินาที
LLM_THINKING_NOTICE_SECONDS=3

# โฟลเดอร์เก็บประวัติการสนทนา (ถูก .gitignore ไว้แล้ว)
LLM_LOG_DIR=logs
